{
  "manifest_version": 3,
  "name": "Follower Diff",
  "version": "2.0.0",
  "description": "Keep local snapshots of your Instagram followers and following, and see exactly what changed between them.",
  "homepage_url": "https://github.com/anar-bastanov/follower-diff-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Follower Diff",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": [
        "src/shared/storage.js",
        "src/content/ig-api.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
